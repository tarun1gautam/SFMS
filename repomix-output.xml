const filterfiles = combinedItems.filter(f => {
  if (!expoFolder) return false;
  const normalizedExpo = expoFolder.endsWith('/') ? expoFolder : `${expoFolder}/`;
  const isSharedView = normalizedExpo.toLowerCase() === '/shared/';
  if (isSharedView) {
