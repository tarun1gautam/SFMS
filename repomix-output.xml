                  className="w-full flex items-center gap-2.5 px-4 py-2.5 text-sm text-subtle dark:text-gray-300 hover:bg-field dark:hover:bg-gray-800 hover:text-ink dark:hover:text-white transition-all cursor-pointer"
                >
